    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Use 'extracted_text' or whatever variable your previous HTML node outputs\n  let text = item.json.extracted_text || '';\n\n  // 1. ELIMINATE INVISIBLE SPACER/PREVIEW CHARACTERS\n  // Targets specific hidden Unicode strings (Zero-width spaces, soft hyphens, figure spaces)\n  text = text.replace(/[\\u2007\\u034f\\u00ad\\u200b\\u200c\\u200d\\ufeff]/g, '');\n\n  // 2. STRIP BRACKETED URLS (e.g., [https://...])\n  text = text.replace(/\\[https?:\\/\\/[^\\]]+\\]/gi, '');\n\n  // 3. STRIP STANDALONE NAKED URLS (e.g., https://microcenter-cdn...)\n  // This matches standard web links dropped on their own line or inside spaces\n  text = text.replace(/https?:\\/\\/[^\\s]+/gi, '');\n\n  // 4. CLEAN UP LEFTOVER BRACKET ARTIFACTS\n  // Wipes out any hanging empty pairs \"[]\" or lines with just an arrow symbol left behind\n  text = text.replace(/\\[\\s*\\]/g, '');\n  text = text.replace(/Click here»|Unable to see images\\?/gi, '');\n\n  // 5. CONDENSE SPACE AND MULTI-LINE BREAKS\n  // Trims spaces on individual lines, removes empty lines containing only spaces\n  text = text.split('\\n').map(line => line.trim()).join('\\n');\n  // Compresses 3 or more stacked line breaks into a clean double line-break\n  text = text.replace(/\\n{3,}/g, '\\n\\n');\n\n  // Save the truly generic output\n  item.json.clean_text = text.trim();\n}\n\nreturn $input.all();\n"
      },
